# Copy this file to .env and fill in your own values.
# The app runs without a key using local assistant guidance.

# Server-side only. Never commit the real key, never send it to the browser,
# and never include it in a release archive.
GEMINI_API_KEY=

# Model used for the optional Gemini assistant and financial summaries.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# NVIDIA NIM (Nemotron)
# ---------------------------------------------------------------------------
# Used for everything except summaries and the assistant: reading documents
# (including scans and images), interpreting what-if scenarios, subscription
# alternatives, and spending suggestions. Optional — without it those features
# say so and the deterministic calculations keep working.
#
# Get a key at https://build.nvidia.com. Server-side only.
NVIDIA_API_KEY=

# Vision-capable reasoning model.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenAI-compatible endpoint. Override only for a self-hosted NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com

# Leave off unless you specifically want the model's thinking tokens in replies.
NVIDIA_ENABLE_THINKING=false

# Shared AI request policy.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Port for `python app.py` (default 2611).
# PORT=2611

# Where the ledger JSON files live (default ./data).
FINANCE_DATA_DIR=./data

# Legacy name, still honoured if FINANCE_DATA_DIR is not set.
# ACCOUNTING_DATA_DIR=./data
